# Backend Environment Configuration
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the actual .env file to version control.

# --- Database Setup ---
DB_HOST=db
DB_USER=admin
DB_PASSWORD=your_strong_database_password_here
DB_NAME=pancatz_leasing

# --- Authentication ---
# REQUIRED: Generate with: openssl rand -hex 64
# The server will refuse to start in production if this is not set.
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_-hex_64

# --- CORS ---
# Comma-separated list of allowed frontend origins
# For local dev: http://localhost:5173
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# --- LLM / AI Configuration ---
# Option A: Local Ollama (default — no key needed)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
OLLAMA_HOST=http://ollama:11434
LLM_API_URL=http://ollama:11434/api/chat
OLLAMA_API_KEY=

# Option B: Cloud / OpenAI-compatible provider
# Uncomment and fill in if using a cloud LLM endpoint
# LLM_PROVIDER=openai
# LLM_MODEL=your-cloud-model-name
# LLM_API_URL=https://your-cloud-endpoint/v1/chat/completions
# OLLAMA_API_KEY=your_cloud_api_key_here
