# Backend Environment Configuration Example
# Copy this file to `.env` and replace the values with your actual secrets.

# --- Database Setup ---
DB_HOST=db
DB_USER=admin
DB_PASSWORD=local_dev_password
DB_NAME=pancatz_leasing

# --- Authentication ---
# Generate a strong secret string in production, e.g., using `openssl rand -hex 64`
JWT_SECRET=dev_secret_key

# --- LLM / AI Configuration ---
OLLAMA_HOST=http://ollama:11434
# Optional: Set this if your Ollama instance requires authentication
OLLAMA_API_KEY=6914c375ebf2431cbdecfcbe2374974a.WWEsVKuLP_pKFnaaTuIadMLH
# The LLM model you want Eva to use
LLM_MODEL=nemotron-3-nano:30b-cloud #qwen2.5:1.5b
LLM_PROVIDER=ollama
# If using a cloud provider (e.g. OpenAI), change the API URL
LLM_API_URL=http://ollama:11434/api/chat
