# Frontend Environment Configuration Example
# Copy this file to `.env` and replace the values with your actual configuration.

# The base URL of your API backend. 
# Defaults to `/api` which relies on the Vite development proxy or an Nginx reverse proxy in production.
# If hosting the frontend on a CDN or separately from the backend, set this to the full backend URL containing the /api prefix.
VITE_API_URL=/api

# Application Title shown on login and header
VITE_APP_TITLE=Engwah Leasing System
